# RetailCo DWH/lakehouse stand — environment
# Креды девелопмент-стенда; не для продакшена.

# PostgreSQL (источники erp/crm + метабаза Lakekeeper)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=retailco_pg
POSTGRES_DB=retailco
PGDATA=/var/lib/postgresql/data

# Объектное хранилище: RustFS (Apache-2.0, S3/MinIO-совместимый форк).
# MinIO удалён с Docker Hub/quay (2026) — замена задокументирована в verification-log.
RUSTFS_ROOT_USER=minioadmin
RUSTFS_ROOT_PASSWORD=minioadmin
RUSTFS_BUCKET=retailco
RUSTFS_TAG=latest

# Lakekeeper (Iceberg REST catalog)
LAKEKEEPER_DB=lakekeeper_meta
LAKEKEEPER_DB_USER=lakekeeper
LAKEKEEPER_DB_PASSWORD=lakekeeper
LAKEKEEPER_WAREHOUSE=retailco

# StarRocks
SR_MYSQL_PORT=9030
SR_HTTP_PORT=8030

# Image tags — фиксируются на M0 (§8.5 плана: датируемые утверждения перепроверяются)
PG_TAG=17-alpine
MINIO_TAG=latest
LAKEKEEPER_TAG=latest
STARROCKS_TAG=4.1-latest
